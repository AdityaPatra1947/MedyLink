# Copy this file to .env. scripts/setup.ps1 generates local secrets automatically.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
JWT_SIGNING_KEY=replace-with-a-different-random-secret-of-at-least-50-characters
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_ORIGIN=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Optional in single-process development; required in production.
REDIS_URL=
# Development verification/reset messages appear only in the backend terminal.
# Production must use django.core.mail.backends.smtp.EmailBackend.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=MedyLink <noreply@example.com>
# Set an absolute persistent private path in production.
PRIVATE_MEDIA_ROOT=

# Optional health metrics; leave empty until an owner-reviewed policy is supplied.
# See docs/PATIENT_HEALTH_DATA.md. Missing/invalid policy leaves score and risk unavailable.
HEALTH_SCORE_POLICY_JSON=
# Optional operator-controlled dotted Python callable for a reviewed regional alert source.
# Leave empty until the adapter is implemented; unavailable never means no outbreak.
HEALTH_ALERTS_PROVIDER=
